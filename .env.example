# Image Studio (localhost dev tool)
# Aktif otomatis di NODE_ENV=development, atau set IMAGE_STUDIO_ENABLED=true

IMAGE_STUDIO_ENABLED=true

# Black Forest Labs — FLUX.2 (dari profil BFL, sama akun MCP)
BFL_API_KEY=

# OpenAI — GPT Image 2 (pay-as-you-go, starter credit akun baru)
OPENAI_API_KEY=

# Google AI — Nano Banana 2 / gemini-3.1-flash-image-preview
GOOGLE_GENERATIVE_AI_API_KEY=

# Distributed rate limit (BN-SEC-005). Optional locally; set on Vercel Production + Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
