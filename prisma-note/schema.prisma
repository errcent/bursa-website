// Isolated Bursa Note schema. Separate Prisma Postgres instance in production.
// Do not import this into the course Prisma client.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/note-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("NOTE_DATABASE_URL")
  directUrl = env("NOTE_DIRECT_URL")
}

model NoteAccount {
  id         String   @id @default(cuid())
  apexUserId String   @unique
  plus       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  entries    JournalEntry[]
  journalSchema NoteJournalSchema?
}

model NoteJournalSchema {
  id         String   @id @default(cuid())
  account    NoteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String   @unique
  /** JournalDbSchema JSON */
  schema     Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model JournalEntry {
  id             String      @id @default(cuid())
  account        NoteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  kind           String
  mode           String
  symbol         String
  side           String
  qty            Float?
  entryPrice     Float?
  exitPrice      Float?
  fees           Float?
  pnl            Float?
  result         String?
  emotion        String?
  note           String?
  ruleBroken     String?
  lesson         String?
  clinicModuleId String?
  protocol       String?
  accountLabel   String?
  relatedCourseSlug String?
  relatedLessonId   String?
  /** Flexible Notion-style property bag */
  properties     Json?
  openedAt       DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([accountId, createdAt])
}

model NoteSsoCode {
  code       String   @id
  apexUserId String
  email      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

/** Generic per-user JSON store: sync accounts (encrypted), prop ledger, routines, misses. */
model NoteUserBlob {
  id         String   @id @default(cuid())
  apexUserId String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([apexUserId, key])
  @@index([apexUserId])
}

/** Per-trade summary embeddings for Ask Your Journal (pgvector). */
model NoteAskEmbedding {
  id         String   @id @default(cuid())
  apexUserId String
  ref        String
  summary    String
  embedding  Unsupported("vector(1536)")
  updatedAt  DateTime @updatedAt

  @@unique([apexUserId, ref])
  @@index([apexUserId])
}
