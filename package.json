{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && prisma migrate deploy && tsx scripts/sync-legal-drafts.ts --force && next build",
    "start": "next start",
    "lint": "eslint",
    "test:waitlist": "tsx --test tests/waitlist-lifecycle.test.ts",
    "setup:waitlist-email": "tsx scripts/setup-waitlist-email.ts",
    "enable:waitlist-onboarding": "tsx scripts/enable-waitlist-onboarding.ts",
    "disable:waitlist-onboarding": "tsx scripts/disable-waitlist-onboarding.ts",
    "bootstrap:production-admin": "tsx scripts/bootstrap-production-admin.ts",
    "purge:dev-accounts": "tsx scripts/purge-dev-accounts.ts",
    "seed:preview-catalog": "tsx scripts/seed-preview-catalog.ts",
    "test:email-policy": "tsx --test tests/email-policy.test.ts",
    "postinstall": "prisma generate && node scripts/ensure-patched-sharp.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "thumbnails:generate": "tsx scripts/generate-ai-thumbnails.ts",
    "audit:pages": "tsx scripts/audit-pages-network.ts",
    "sync-legal": "tsx scripts/copy-legal-content.ts && tsx scripts/sync-legal-drafts.ts",
    "copy-legal": "tsx scripts/copy-legal-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^7.9.1",
    "@react-email/render": "^2.1.0",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/turndown": "5.0.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "posthog-js": "^1.409.5",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "turndown": "7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.16",
    "@hono/node-server": "^2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "playwright": "^1.61.1",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
