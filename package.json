{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && prisma generate --schema prisma-note/schema.prisma && node scripts/retry-failed-locale-migration.mjs && prisma migrate deploy && node scripts/migrate-note-if-configured.mjs && tsx scripts/sync-legal-drafts.ts --force && next build",
    "start": "next start",
    "lint": "eslint",
    "test:waitlist": "tsx --test tests/waitlist-lifecycle.test.ts",
    "setup:waitlist-email": "tsx scripts/setup-waitlist-email.ts",
    "enable:waitlist-onboarding": "tsx scripts/enable-waitlist-onboarding.ts",
    "disable:waitlist-onboarding": "tsx scripts/disable-waitlist-onboarding.ts",
    "bootstrap:production-admin": "tsx scripts/bootstrap-production-admin.ts",
    "purge:dev-accounts": "tsx scripts/purge-dev-accounts.ts",
    "seed:preview-catalog": "tsx scripts/seed-preview-catalog.ts",
    "sync:catalog-copy": "tsx scripts/sync-catalog-copy.ts",
    "test:email-policy": "tsx --test tests/email-policy.test.ts",
    "test:security-bn": "tsx --test tests/auth-redirect.test.ts tests/rate-limit-key.test.ts tests/auth-secret-and-ip.test.ts tests/web-session-jti.test.ts tests/mentor-application-urls.test.ts tests/mentor-application-pipeline.test.ts tests/google-oauth-reclaim.test.ts tests/content-security-policy.test.ts",
    "test:note": "tsx --test tests/note-taxonomy.test.ts tests/note-entitlements.test.ts tests/note-csv.test.ts tests/note-hosts.test.ts tests/note-sso-urls.test.ts tests/note-stats.test.ts tests/note-prefs.test.ts",
    "postinstall": "prisma generate && prisma generate --schema prisma-note/schema.prisma && node scripts/ensure-patched-sharp.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:note:generate": "prisma generate --schema prisma-note/schema.prisma",
    "db:note:deploy": "prisma migrate deploy --schema prisma-note/schema.prisma",
    "thumbnails:generate": "tsx scripts/generate-ai-thumbnails.ts",
    "audit:pages": "tsx scripts/audit-pages-network.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:visual": "playwright test e2e/visual-audit.spec.ts",
    "sync-legal": "tsx scripts/copy-legal-content.ts && tsx scripts/sync-legal-drafts.ts",
    "copy-legal": "tsx scripts/copy-legal-content.ts",
    "sync:brand": "tsx scripts/sync-brand-assets.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@react-email/render": "^2.1.0",
    "@tiptap/extension-link": "3.27.3",
    "@tiptap/extension-placeholder": "3.27.3",
    "@tiptap/extension-underline": "3.27.3",
    "@tiptap/pm": "3.27.3",
    "@tiptap/react": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "posthog-js": "^1.405.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "turndown": "7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.16",
    "@hono/node-server": "^2.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "5.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "playwright": "^1.61.1",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
